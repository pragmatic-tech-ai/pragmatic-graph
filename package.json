    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "lmdb": "^3.5.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
