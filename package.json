{
  "name": "@pragmatic-tech-ai/graph",
  "version": "0.1.0",
  "description": "Graph database storage engine: KV layer and graph layout",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
